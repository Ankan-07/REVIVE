# syntax=docker/dockerfile:1
# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install deps first for layer caching
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy source and build
# VITE_API_URL is the public URL of the API from the browser's perspective.
# Inside the Docker stack (via Nginx proxy) this is typically just "" (empty —
# same origin, proxied to api:8000 by nginx). Override for external deployments.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

COPY frontend/ ./
RUN npm run build

# ── Stage 2: nginx static server ─────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Inject our custom config (includes security headers, SPA fallback, API proxy)
COPY nginx/nginx.conf /etc/nginx/conf.d/revive.conf

# Copy built frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost/healthz-static || exit 1

CMD ["nginx", "-g", "daemon off;"]
