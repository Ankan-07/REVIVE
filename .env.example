# ==============================================================================
# Revenue Rescue Engine (REVIVE) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed to source control.
#
# In production (APP_ENV=prod), missing or invalid required settings will cause
# the application and background worker to immediately refuse to boot.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Core Controls
# ------------------------------------------------------------------------------
# Environment profile: 'dev' | 'local' | 'staging' | 'prod'
# In 'prod', all safety guards, test-mode guards, and strict validators are enforced.
APP_ENV=dev

# Internal API Base URL (used by detector and background services to post events)
# Local: http://127.0.0.1:8000 | In Docker Compose: http://api:8000
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Database Connections (Supabase Managed Postgres)
# ------------------------------------------------------------------------------
# Direct connection (port 5432): used by Alembic migrations and LangGraph checkpointer
# SUPABASE_DB_URL=postgresql+psycopg://postgres:[password]@db.[project].supabase.co:5432/postgres?sslmode=require

# Session-mode pooled connection (PgBouncer, port 6543): used by FastAPI and ARQ workers
# Transaction mode (port 5432 pooler) is STRICTLY PROHIBITED (breaks SELECT ... FOR UPDATE).
# In production, SQLite is refused at startup. Default for dev/tests: sqlite:///./revive.db
DATABASE_URL=sqlite:///./revive.db

# Optional migration override URL (used in CI or dedicated migration tasks)
# ALEMBIC_DB_URL=

# ------------------------------------------------------------------------------
# 3. Authentication, Sessions & Operator Identity (Phase A2)
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing httpOnly operator session cookies.
# REQUIRED in production. Must be changed from the dev default.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=revive-insecure-dev-secret-key-change-in-production

# Session cookie TTL in seconds (default: 28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Optional initial operator key to bootstrap into the DB on first boot.
# Hashed with PBKDF2-HMAC-SHA256 upon first boot, then ignored.
BOOTSTRAP_API_KEY=

# When set to true, allows admin/eval routes to operate in production.
# Keep false unless explicitly performing maintenance with security sign-off.
ADMIN_ALLOWED_IN_PROD=false

# ------------------------------------------------------------------------------
# 4. CORS Origins (Phase A3)
# ------------------------------------------------------------------------------
# Allowed web origins for browser access.
# NOTE: In APP_ENV=prod, startup validator REFUSES to boot if any localhost/127.0.0.1
# origin is present. Use your actual production domains (comma-separated or JSON list).
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost", "http://127.0.0.1"]
# Production example:
# CORS_ORIGINS=["https://revive.yourcompany.com"]

# ------------------------------------------------------------------------------
# 5. Payments — Razorpay (TEST MODE ONLY — Phase A5 / B1)
# ------------------------------------------------------------------------------
# IMPORTANT: REVIVE is architecturally locked to Razorpay TEST MODE ONLY.
# RAZORPAY_KEY_ID MUST start with 'rzp_test_'. Live keys ('rzp_live_...') are strictly
# refused by startup guards in all environments to prevent unintended money movement.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. Messaging — Email (Resend — Phase A5 / C1)
# ------------------------------------------------------------------------------
# API key from resend.com. Required in production.
RESEND_API_KEY=re_your_resend_api_key
# Verified sender domain or mailbox address (e.g. "REVIVE <recovery@yourcompany.com>")
RESEND_SENDER=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 7. Messaging — SMS (Twilio — Phase A5 / C1)
# ------------------------------------------------------------------------------
# Twilio Account SID (starts with AC...) and Auth Token. Required in production.
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Verified Twilio phone number in E.164 format (e.g. +1234567890)
TWILIO_FROM_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 8. Background Task Queue — Redis & ARQ (Phase A4)
# ------------------------------------------------------------------------------
# Redis broker URL. Use rediss:// with TLS in production.
REDIS_URL=redis://localhost:6379

# When true, runs recovery agent synchronously within the HTTP request.
# Set to false in production to enqueue runs asynchronously to ARQ and return 202 Accepted.
SYNC_RUN_AGENT=true

# ------------------------------------------------------------------------------
# 9. LLM Provider & Tracing (OpenAI & LangSmith)
# ------------------------------------------------------------------------------
# OpenAI or compatible API key (NVIDIA NIM, Azure OpenAI, etc.)
OPENAI_API_KEY=
# Optional base URL override (e.g. https://integrate.api.nvidia.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini
DIAGNOSIS_LLM_MODEL=gpt-4o

# LangSmith observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=revenue-rescue-engine
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Maximum graph loop iterations per recovery case before halting
MAX_AGENT_ITERATIONS=6

# ------------------------------------------------------------------------------
# 10. Simulation & Lab Track
# ------------------------------------------------------------------------------
# Deterministic seed for the isolated synthetic benchmark lab
SIMULATION_SEED=42

# ------------------------------------------------------------------------------
# 11. Alerting & Incident Response (Phase A3.5 / B1)
# ------------------------------------------------------------------------------
# Email address to receive critical security alerts (e.g. webhook HMAC failure spikes)
ADMIN_ALERT_EMAIL=
# Threshold of failed webhook HMAC verifications in 5 minutes before alerting ops
HMAC_FAILURE_ALERT_THRESHOLD=10
