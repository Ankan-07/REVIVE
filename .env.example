# Revenue Rescue Engine — environment template.
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# --- Application Environment ---
# Controls fallback behavior and strict guards: 'local' | 'staging' | 'prod'
APP_ENV=local

# --- LLM provider (OpenAI) ---
# Required for the diagnose/plan LLM nodes. The Phase 0 tracing smoke test works
# without it (falls back to a deterministic message step).
OPENAI_API_KEY=
# OPENAI_BASE_URL can point at any OpenAI-compatible endpoint (OpenAI, NVIDIA, etc.);
# set DEFAULT_LLM_MODEL/DIAGNOSIS_LLM_MODEL to models that provider actually serves.
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEFAULT_LLM_MODEL=gpt-4o-mini
# DIAGNOSIS_LLM_MODEL=gpt-4o

# --- LangSmith tracing (PRD §42, BUILDPLAN Phase 0) ---
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here   # required to send traces
LANGSMITH_TRACING=true                         # master on/off switch
LANGSMITH_PROJECT=revenue-rescue-engine        # groups traces in the LangSmith UI
# LANGSMITH_WORKSPACE_ID=                       # only needed for org-scoped keys
# Data-region endpoint — MUST match your workspace's region or ingestion 403s:
#   US (default): https://api.smith.langchain.com
#   EU:           https://eu.api.smith.langchain.com
#   AU/APAC:      https://apac.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Simulation (BUILDPLAN §2, reproducibility §27) ---
SIMULATION_SEED=42

# --- Database Connections (Postgres / Supabase) ---
# Direct connection (port 5432): used for Alembic migrations and LangGraph durable checkpointer
# SUPABASE_DB_URL=postgresql+psycopg://postgres:[password]@db.[project].supabase.co:5432/postgres?sslmode=require
# Pooled connection in session mode (port 6543): used by FastAPI and background workers
# DATABASE_URL=postgresql+psycopg://postgres.[project]:[password]@[region].pooler.supabase.com:6543/postgres?sslmode=require
# Defaults to sqlite:///./revive.db if unset

# --- Razorpay Standard Checkout & Webhooks (TEST MODE ONLY) ---
# Test-mode keys (rzp_test_...) from the Razorpay Dashboard (Settings > API Keys).
# Live keys (rzp_live_...) are strictly refused by application startup guards.
# The frontend needs only the KEY_ID (as VITE_RAZORPAY_KEY_ID in frontend/.env) — never the KEY_SECRET.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Messaging Provider: Resend (Email) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_SENDER=onboarding@resend.dev

# --- Messaging Provider: Twilio (SMS) ---
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# --- Background Worker & Task Queue (Phase A4) ---
# Redis broker URL (use rediss:// with TLS in production)
REDIS_URL=redis://localhost:6379
# When true, runs recovery agent synchronously within the HTTP request (useful for unit tests/local dev)
SYNC_RUN_AGENT=true
